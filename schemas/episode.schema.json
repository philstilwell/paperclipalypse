{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paperclipalypse Codex Episode",
  "type": "object",
  "required": ["premise", "contestants", "jokes", "judgeResults"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contestants": { "maxItems": 4 }
        }
      },
      "then": {
        "required": ["participationException"],
        "properties": {
          "jokes": { "maxItems": 4 },
          "judgeResults": {
            "maxItems": 4,
            "items": {
              "properties": {
                "scores": { "maxItems": 3 }
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["participationException"] },
      "then": {
        "properties": {
          "contestants": { "maxItems": 4 },
          "jokes": { "maxItems": 4 },
          "judgeResults": { "maxItems": 4 }
        }
      }
    }
  ],
  "properties": {
    "createdAt": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "participationException": {
      "type": "object",
      "required": ["type", "unavailableContestantIds", "details"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "model-outage" },
        "unavailableContestantIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "details": { "type": "string", "minLength": 1 }
      }
    },
    "seedTerms": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "premise": {
      "type": "object",
      "required": ["place", "person", "element", "text"],
      "additionalProperties": false,
      "properties": {
        "place": { "type": "string" },
        "person": { "type": "string" },
        "element": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "contestants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "displayName"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "style": { "type": "string" }
        }
      }
    },
    "jokes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "contestantId", "contestantName", "title", "setup", "punchline"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "contestantId": { "type": "string" },
          "contestantName": { "type": "string" },
          "model": { "type": "string" },
          "title": { "type": "string" },
          "seedTermsUsed": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "joke": { "type": "string" },
          "text": { "type": "string" },
          "setup": { "type": "string" },
          "punchline": { "type": "string" }
        }
      }
    },
    "judgeResults": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["judgeId", "judgeName", "scores"],
        "additionalProperties": false,
        "properties": {
          "judgeId": { "type": "string" },
          "judgeName": { "type": "string" },
          "scores": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "jokeId",
                "originality",
                "surprise",
                "craft",
                "promptFit",
                "laugh",
                "comment"
              ],
              "additionalProperties": false,
              "properties": {
                "jokeId": { "type": "string" },
                "originality": { "type": "integer", "minimum": 1, "maximum": 10 },
                "surprise": { "type": "integer", "minimum": 1, "maximum": 10 },
                "craft": { "type": "integer", "minimum": 1, "maximum": 10 },
                "promptFit": { "type": "integer", "minimum": 1, "maximum": 10 },
                "laugh": { "type": "integer", "minimum": 1, "maximum": 10 },
                "comment": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "comicPanelPrompt": {
      "type": "string"
    }
  }
}
