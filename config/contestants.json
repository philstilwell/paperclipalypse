{
  "contestants": [
    {
      "id": "openai",
      "displayName": "OpenAI GPT-5.4 Mini",
      "provider": "openai",
      "apiKeyEnv": "OPENAI_API_KEY",
      "modelEnv": "OPENAI_MODEL",
      "defaultModel": "gpt-5.4-mini",
      "billing": "paid-api",
      "freeAutomation": false,
      "notes": "Use through Codex/ChatGPT manually when staying subscription-only; OpenAI API calls are metered separately."
    },
    {
      "id": "anthropic",
      "displayName": "Claude",
      "provider": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "modelEnv": "ANTHROPIC_MODEL",
      "defaultModel": "Sonnet 5 Medium",
      "billing": "paid-api",
      "freeAutomation": false,
      "notes": "Claude category; the visible web model changed to Sonnet 5 Medium on 2026-08-20. API calls are metered unless covered by separate provider credits."
    },
    {
      "id": "google",
      "displayName": "Gemini Flash",
      "provider": "google",
      "apiKeyEnv": "GOOGLE_API_KEY",
      "modelEnv": "GOOGLE_MODEL",
      "defaultModel": "gemini-3.5-flash",
      "billing": "free-tier-eligible",
      "freeAutomation": true,
      "notes": "Google documents a free tier for Gemini 3.5 Flash text generation; verify quota and data-use terms before enabling."
    },
    {
      "id": "xai",
      "displayName": "xAI Grok 4.3",
      "provider": "openai-compatible",
      "baseUrl": "https://api.x.ai/v1",
      "apiKeyEnv": "XAI_API_KEY",
      "modelEnv": "XAI_MODEL",
      "defaultModel": "grok-4.3",
      "billing": "paid-api",
      "freeAutomation": false,
      "notes": "Low-cost Grok option, but xAI API use is still metered."
    },
    {
      "id": "copilot",
      "displayName": "Copilot",
      "provider": "manual-web",
      "defaultModel": "Microsoft Copilot web",
      "billing": "manual-web",
      "freeAutomation": false,
      "apiAutomation": false,
      "notes": "Use manually through Microsoft Copilot's chat surface. No paid API automation is configured for this hobby workflow."
    }
  ]
}
