# Optional paid API mode only. The default project path does not require these.
# Copy to .env only if you later decide to run live provider API calls locally.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Optional model overrides. Keep these aligned with the provider docs.
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_MODEL=gemini-2.5-pro
XAI_MODEL=grok-4
MISTRAL_MODEL=mistral-large-latest

# Set to 1 for deterministic local mock contestants/judges.
PAPERCLIPALYPSE_DRY_RUN=0
