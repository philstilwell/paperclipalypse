# Optional external API mode only. The default project path does not require
# these and will not spend money.
# Copy to .env only if you later decide to run live provider API calls locally.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Optional model overrides. Keep these aligned with the provider docs.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_MODEL=gemini-3.5-flash
XAI_MODEL=grok-4.3

# Required for any metered external API contestant. Leave unset for hobby mode.
PAPERCLIPALYPSE_ALLOW_PAID_API=0

# Set to 1 for deterministic local mock contestants/judges.
PAPERCLIPALYPSE_DRY_RUN=0
